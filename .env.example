# ─────────────────────────────────────────────────────────────────────
# SPIRE environment template.  Copy to .env and fill in the blanks.
#
#   cp .env.example .env
#   $EDITOR .env
#
# This file is tracked by git.  .env is not.
#
# What does NOT belong here:
#   * Ports        — those live in SPIRE-PORTS.env, applied by compose.sh
#   * SPIRE_PERSONA — set by compose.sh (default_dev / default_prod)
#   * Fusion creds  — those live in personas.yaml (bind-mounted, rotated weekly)
#   * Oracle creds  — same, they live in personas.yaml
#
# Only LLM provider keys are secrets that must be per-machine.
# ─────────────────────────────────────────────────────────────────────

# Gemini (the default provider).  If the installed langchain-google-genai
# expects GOOGLE_API_KEY instead, compose sets that from this value too —
# you only maintain one.
GEMINI_API_KEY=

# Optional — only needed when SPIRE_LLM_PROVIDER is set to the matching
# value.  Leave blank if unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
