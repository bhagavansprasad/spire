# SPIRE-PORTS.env — single source of truth for SPIRE ports.
#
# Sourced by:
#   - run-all.sh                    (this repo)
#   - spire() / spirer()            in ~/.bashrc
#
# To change a port, change it HERE ONLY. Nothing else needs editing.
#
# The rule both sets follow: X00Y, where X is 3 for the runtime and 4 for
# dev, and Y is 1/2/3 for MCP/API/UI.
#
#   Production: 3001 / 3002 / 3003   testers, reached via ngrok
#   Dev:     4001 / 4002 / 4003   local development
#
# COMMIT THIS FILE. It is config, not a secret.

# Production (testers, via ngrok)
SPIRE_PRODUCTION_MCP_PORT=3001
SPIRE_PRODUCTION_API_PORT=3002
SPIRE_PRODUCTION_UI_PORT=3003

# Dev (local)
SPIRE_DEV_MCP_PORT=4001
SPIRE_DEV_API_PORT=4002
SPIRE_DEV_UI_PORT=4003